# Bank Account Query Server Configuration

# gRPC Server
BANK_ACCOUNT_QUERY_GRPC_PORT=50054
BANK_ACCOUNT_QUERY_HEALTH_PORT=8054

# Database
BANK_ACCOUNT_QUERY_DB_DRIVER=postgres
BANK_ACCOUNT_QUERY_DB_URL=postgres://postgres:postgres@localhost:5432/bankaccountdb?sslmode=disable

# Logging
LOG_LEVEL=info

# Graceful Shutdown
SHUTDOWN_TIMEOUT=30s

# Environment
ENV=development

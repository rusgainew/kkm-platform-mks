# Server Configuration
DOCUMENT_QUERY_GRPC_PORT=50062
DOCUMENT_QUERY_METRICS_PORT=9103

# Database
DOCUMENT_QUERY_DB_DRIVER=postgres
DOCUMENT_QUERY_DB_URL=postgres://postgres:postgres@localhost:5432/document_db?sslmode=disable

# Observability
JAEGER_ENDPOINT=http://localhost:14268/api/traces
LOG_LEVEL=info

# Redis Cache
DOCUMENT_QUERY_REDIS_URL=redis://localhost:6379/3
DOCUMENT_QUERY_CACHE_TTL=10m

# RabbitMQ Consumer (Event-Driven Updates)
DOCUMENT_QUERY_RABBITMQ_ENABLED=true
DOCUMENT_QUERY_RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
DOCUMENT_QUERY_RABBITMQ_EXCHANGE=documents

# Invoice Query Server Configuration

# gRPC Server
INVOICE_QUERY_GRPC_PORT=50053
INVOICE_QUERY_HEALTH_PORT=8053

# Database
INVOICE_QUERY_DB_DRIVER=postgres
INVOICE_QUERY_DB_URL=postgres://postgres:postgres@localhost:5432/invoicedb?sslmode=disable

# Logging
LOG_LEVEL=info

# Graceful Shutdown
SHUTDOWN_TIMEOUT=30s

# Environment
ENV=development

# Catalog Query Server Configuration

# gRPC Server
CATALOG_QUERY_GRPC_PORT=50055
CATALOG_QUERY_HEALTH_PORT=8055

# Database
CATALOG_QUERY_DB_DRIVER=postgres
CATALOG_QUERY_DB_URL=postgres://postgres:postgres@localhost:5432/catalogdb?sslmode=disable

# Logging
LOG_LEVEL=info

# Graceful Shutdown
SHUTDOWN_TIMEOUT=30s

# Environment
ENV=development

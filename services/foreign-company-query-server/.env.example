# Foreign Company Query Server Configuration

# gRPC Server
FOREIGN_COMPANY_QUERY_GRPC_PORT=50057
FOREIGN_COMPANY_QUERY_HEALTH_PORT=8057

# Database
FOREIGN_COMPANY_QUERY_DB_DRIVER=postgres
FOREIGN_COMPANY_QUERY_DB_URL=postgres://postgres:postgres@localhost:5432/foreigncompanydb?sslmode=disable

# Logging
LOG_LEVEL=info

# Graceful Shutdown
SHUTDOWN_TIMEOUT=30s

# Redis Cache
REDIS_URL=redis://localhost:6379/1
CACHE_TTL=10m

# OpenTelemetry / Jaeger
JAEGER_ENDPOINT=http://localhost:14268/api/traces

# JWT Authentication
JWT_SECRET=test-jwt-secret-key-12345

# Environment
ENV=development

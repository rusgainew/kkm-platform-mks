# Catalog Server Configuration

# Server
CATALOG_SERVER_HOST=0.0.0.0
CATALOG_SERVER_PORT=50053
CATALOG_SERVER_METRICS_PORT=9093

# Database
CATALOG_SERVER_DB_DRIVER=postgres
CATALOG_SERVER_DB_URL=postgres://postgres:postgres@localhost:5432/catalogdb?sslmode=disable

# Redis (optional, for caching)
CATALOG_SERVER_REDIS_URL=redis://localhost:6379/0

# RabbitMQ (for event publishing)
CATALOG_SERVER_RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Observability
CATALOG_SERVER_JAEGER_URL=http://localhost:14268/api/traces
CATALOG_SERVER_LOG_LEVEL=info

# Environment
CATALOG_SERVER_ENVIRONMENT=development

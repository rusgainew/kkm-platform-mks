# Bank Account Server Configuration

# Server
BANK_ACCOUNT_SERVER_HOST=0.0.0.0
BANK_ACCOUNT_SERVER_PORT=50054
BANK_ACCOUNT_SERVER_METRICS_PORT=9094

# Database
BANK_ACCOUNT_SERVER_DB_DRIVER=postgres
BANK_ACCOUNT_SERVER_DB_URL=postgres://postgres:postgres@localhost:5432/bankaccountdb?sslmode=disable

# Redis (optional, for caching)
BANK_ACCOUNT_SERVER_REDIS_URL=redis://localhost:6379/0

# RabbitMQ (for event publishing)
BANK_ACCOUNT_SERVER_RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Observability
BANK_ACCOUNT_SERVER_JAEGER_URL=http://localhost:14268/api/traces
BANK_ACCOUNT_SERVER_LOG_LEVEL=info

# Environment
BANK_ACCOUNT_SERVER_ENVIRONMENT=development

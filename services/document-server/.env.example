# Database
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=document_db
DB_SSLMODE=disable

# Server
SERVER_PORT=50054
METRICS_PORT=9094

# Observability
SERVICE_NAME=document-server
LOG_LEVEL=info
ENABLE_TRACING=false
JAEGER_ENDPOINT=http://jaeger:14268/v1/traces

# RabbitMQ
RABBITMQ_ENABLED=true
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
RABBITMQ_EXCHANGE=documents
RABBITMQ_EXCHANGE_TYPE=topic

# JWT
DOCUMENT_SERVER_JWT_SECRET=dev-secret-key-change-in-production
JWT_SECRET=dev-secret-key-change-in-production
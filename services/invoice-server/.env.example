# Server Configuration
SERVER_PORT=50053
GRPC_PORT=50053
METRICS_PORT=9093

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=invoice_db
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m

# RabbitMQ Configuration
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_EXCHANGE=invoice_events
RABBITMQ_EXCHANGE_TYPE=topic

# Observability
JAEGER_ENDPOINT=http://localhost:14268/api/traces
SERVICE_NAME=invoice-server
LOG_LEVEL=info

# Feature Flags
ENABLE_TRACING=true
ENABLE_METRICS=true
ENABLE_EVENTS=true

# Server Configuration
HTTP_PORT=8080
METRICS_PORT=9090

# JWT Configuration
JWT_SECRET=dev-secret-key-change-in-production
JWT_EXPIRATION=24h

# Service Endpoints (gRPC)
USER_SERVICE_URL=localhost:50051
COMPANY_SERVICE_URL=localhost:50052
INVOICE_SERVICE_URL=localhost:50053
CATALOG_SERVICE_URL=localhost:50054
BANK_ACCOUNT_SERVICE_URL=localhost:50055
FOREIGN_COMPANY_SERVICE_URL=localhost:50056

# Query Service Endpoints (gRPC)
INVOICE_QUERY_SERVICE_URL=localhost:50057
CATALOG_QUERY_SERVICE_URL=localhost:50058
BANK_ACCOUNT_QUERY_SERVICE_URL=localhost:50059

# Observability
JAEGER_ENDPOINT=http://localhost:14268/api/traces
SERVICE_NAME=api-gateway
LOG_LEVEL=info

# Feature Flags
ENABLE_TRACING=true
ENABLE_METRICS=true
ENABLE_CORS=true

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:4000
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization
CORS_MAX_AGE=3600

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=1m

# Timeouts
REQUEST_TIMEOUT=30s
GRPC_DIAL_TIMEOUT=5s

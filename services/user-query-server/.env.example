# Server Configuration
USER_QUERY_GRPC_PORT=50061
USER_QUERY_METRICS_PORT=9102

# Database
USER_QUERY_DB_DRIVER=postgres
USER_QUERY_DB_URL=postgres://postgres:postgres@localhost:5432/userdb?sslmode=disable

# Observability
JAEGER_ENDPOINT=http://localhost:14268/api/traces
LOG_LEVEL=info

# Redis Cache
USER_QUERY_REDIS_URL=redis://localhost:6379/0
USER_QUERY_CACHE_TTL=10m

# RabbitMQ Consumer (Event-Driven Updates)
USER_QUERY_RABBITMQ_ENABLED=true
USER_QUERY_RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
USER_QUERY_RABBITMQ_EXCHANGE=user-events

# Environment configuration template
# Copy this file to .env and fill in your actual values

# ============================================
# Database Configuration
# ============================================
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=kkm_user_db
DB_SSL_MODE=disable

# ============================================
# Redis Configuration (Optional - for caching and token blacklist)
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ============================================
# JWT Configuration
# ============================================
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION=3600
JWT_REFRESH_EXPIRATION=604800

# ============================================
# Server Configuration
# ============================================
SERVER_HOST=localhost
SERVER_PORT=50051
LOG_LEVEL=info

# ============================================
# Admin User Configuration
# ============================================
# ADMIN_SECRET: Initial admin account password
# 
# Requirements:
#   - Minimum 20 characters
#   - At least 4 numbers (0-9)
#   - At least 4 lowercase letters (a-z)
#   - At least 2 uppercase letters (A-Z)
#   - At least 2 special characters (!@#$%^&*()_+-=[]{}|;:,.<>?)
#
# Example (meets all requirements):
#   Admin@2024Sec#secure99
#     - Length: 23 characters
#     - Numbers: 4 (2, 0, 2, 4, 9, 9) ✓ 6 total, min 4
#     - Lowercase: 14 (a,d,m,i,n,e,c,u,r,e,s) ✓
#     - Uppercase: 2 (A, S) ✓
#     - Special: 2 (@, #) ✓
#
# This password will be used to initialize the admin user (admin@localhost)
# on first application startup if the admin user does not already exist.
#
ADMIN_SECRET=Admin@2024Sec#secure99

# ============================================
# Email Configuration (for password reset)
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@kkm-system.com

# ============================================
# Security Configuration
# ============================================
# CORS settings
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization

# ============================================
# Observability Configuration
# ============================================
# Jaeger distributed tracing
JAEGER_AGENT_HOST=localhost
JAEGER_AGENT_PORT=6831

# Prometheus metrics
METRICS_PORT=9090

# ============================================
# Feature Flags (optional)
# ============================================
ENABLE_TOKEN_BLACKLIST=true
ENABLE_AUDIT_LOGGING=true
ENABLE_EMAIL_VERIFICATION=false
